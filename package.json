{
  "name": "datacenter-jobs",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "vercel-build": "if [ \"${SKIP_DB_MIGRATIONS:-0}\" != \"1\" ]; then PRISMA_SCHEMA_DISABLE_ADVISORY_LOCK=1 prisma migrate deploy; fi && prisma generate && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "postinstall": "prisma generate",
    "seed": "npx tsx prisma/seed.ts"
  },
  "prisma": {
    "seed": "npx tsx prisma/seed.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.9.1",
    "@prisma/client": "6.18.0",
    "@react-email/components": "^0.5.7",
    "@tailwindcss/typography": "^0.5.19",
    "@vercel/analytics": "^1.5.0",
    "bcryptjs": "^2.4.3",
    "clsx": "^2.1.1",
    "d3-geo": "^3.1.1",
    "date-fns": "^4.1.0",
    "js-cookie": "^3.0.5",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^0.468.0",
    "next": "^16.0.7",
    "next-cloudinary": "^6.16.2",
    "prisma": "6.18.0",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "react-hook-form": "^7.53.2",
    "react-quill-new": "^3.6.0",
    "resend": "^4.0.1",
    "stripe": "^22.3.1",
    "topojson-client": "^3.1.0",
    "us-atlas": "^3.0.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@prisma/nextjs-monorepo-workaround-plugin": "^6.18.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/d3-geo": "^3.1.1",
    "@types/js-cookie": "^3.0.6",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^20.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/topojson-client": "^3.1.5",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.0.7",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.20.6",
    "typescript": "^5.0.0"
  }
