// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  EMPLOYER
  JOB_SEEKER
  ADMIN
}

enum JobStatus {
  ACTIVE
  EXPIRED
  DELETED
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String
  role      UserRole
  company   String? // For employers
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  jobs         Job[] // Posted jobs (for employers)
  applications Application[] // Job applications (for job seekers)
  savedJobs    SavedJob[] // Saved jobs (for job seekers)
  payments     Payment[]

  @@index([email])
  @@index([role])
}

model Job {
  id               String    @id @default(cuid())
  slug             String    @unique
  title            String
  company          String
  companyLogo      String?
  location         String
  type             String // Full-time, Part-time, Contract
  category         String // One of the 10 categories
  shift            String? // Shift requirements
  clearance        String? // Security clearance required
  certifications   String? // Required certifications
  description      String    @db.Text
  requirements     String    @db.Text
  salary           String?
  salaryMin        Int?
  salaryMax        Int?
  hourlyRate       String?
  hourlyRateMin    Float?
  hourlyRateMax    Float?
  applyUrl         String?
  applyEmail       String?
  tags             String[] // Skills/technologies
  status           JobStatus @default(ACTIVE)
  isFeatured       Boolean   @default(false)
  featuredUntil    DateTime?
  expiresAt        DateTime
  viewCount        Int       @default(0)
  applicationCount Int       @default(0)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  // Relations
  userId       String
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  applications Application[]
  savedBy      SavedJob[]
  payment      Payment?

  @@index([slug])
  @@index([status])
  @@index([category])
  @@index([type])
  @@index([shift])
  @@index([clearance])
  @@index([certifications])
  @@index([isFeatured])
  @@index([createdAt])
  @@index([userId])
}

model Application {
  id          String   @id @default(cuid())
  jobId       String
  userId      String
  coverLetter String?  @db.Text
  resume      String? // URL or file path
  status      String   @default("pending") // pending, reviewed, accepted, rejected
  createdAt   DateTime @default(now())

  // Relations
  job  Job  @relation(fields: [jobId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([jobId, userId])
  @@index([userId])
  @@index([jobId])
}

model SavedJob {
  id        String   @id @default(cuid())
  jobId     String
  userId    String
  createdAt DateTime @default(now())

  // Relations
  job  Job  @relation(fields: [jobId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([jobId, userId])
  @@index([userId])
}

model Payment {
  id              String   @id @default(cuid())
  userId          String
  jobId           String   @unique
  stripeSessionId String   @unique
  stripePaymentId String?  @unique
  amount          Int // Amount in cents
  isFeatured      Boolean  @default(false)
  status          String // pending, completed, failed
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  job  Job  @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([stripeSessionId])
}

model Newsletter {
  id         String   @id @default(cuid())
  email      String   @unique
  categories String[] // Selected categories for alerts
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([email])
  @@index([isActive])
}
