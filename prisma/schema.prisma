generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
  engineType    = "library"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                      String                   @id @default(cuid())
  email                   String                   @unique
  password                String
  name                    String
  role                    UserRole
  company                 String?
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  applications            Application[]
  jobs                    Job[]
  notificationPreferences NotificationPreferences?
  payments                Payment[]
  savedJobs               SavedJob[]

  @@index([email])
  @@index([role])
}

model Job {
  id               String        @id @default(cuid())
  slug             String        @unique
  title            String
  company          String
  companyLogo      String?
  location         String
  type             String
  category         String
  shift            String?
  clearance        String?
  certifications   String?
  description      String
  requirements     String
  salary           String?
  salaryMin        Int?
  salaryMax        Int?
  hourlyRate       String?
  hourlyRateMin    Float?
  hourlyRateMax    Float?
  applyUrl         String?
  applyEmail       String?
  tags             String[]
  status           JobStatus     @default(ACTIVE)
  isFeatured       Boolean       @default(false)
  featuredUntil    DateTime?
  expiresAt        DateTime
  viewCount        Int           @default(0)
  applicationCount Int           @default(0)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  email            String?
  managementToken  String?       @unique
  userId           String?
  applications     Application[]
  user             User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
  payment          Payment?
  savedBy          SavedJob[]

  @@index([slug])
  @@index([status])
  @@index([category])
  @@index([type])
  @@index([shift])
  @@index([clearance])
  @@index([certifications])
  @@index([isFeatured])
  @@index([createdAt])
  @@index([userId])
  @@index([email])
  @@index([managementToken])
}

model Application {
  id          String   @id @default(cuid())
  jobId       String
  userId      String
  coverLetter String?
  resume      String?
  status      String   @default("pending")
  createdAt   DateTime @default(now())
  job         Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([jobId, userId])
  @@index([userId])
  @@index([jobId])
}

model SavedJob {
  id        String   @id @default(cuid())
  jobId     String
  userId    String
  createdAt DateTime @default(now())
  job       Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([jobId, userId])
  @@index([userId])
}

model Payment {
  id              String   @id @default(cuid())
  userId          String?
  jobId           String   @unique
  stripeSessionId String   @unique
  stripePaymentId String?  @unique
  amount          Int
  isFeatured      Boolean  @default(false)
  status          String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  job             Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  user            User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([stripeSessionId])
}

model Newsletter {
  id         String   @id @default(cuid())
  email      String   @unique
  categories String[]
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([email])
  @@index([isActive])
}

model NotificationPreferences {
  id                   String   @id @default(cuid())
  userId               String   @unique
  newApplications      Boolean  @default(true)
  expirationReminders  Boolean  @default(true)
  weeklyAnalytics      Boolean  @default(true)
  paymentConfirmations Boolean  @default(true)
  jobAlerts            Boolean  @default(true)
  applicationUpdates   Boolean  @default(true)
  savedJobReminders    Boolean  @default(true)
  weeklyDigest         Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

enum UserRole {
  EMPLOYER
  JOB_SEEKER
  ADMIN
}

enum JobStatus {
  PENDING
  ACTIVE
  EXPIRED
  DELETED
}
