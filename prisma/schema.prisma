generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
  engineType    = "library"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                      String                   @id @default(cuid())
  email                   String                   @unique
  password                String
  name                    String
  role                    UserRole
  company                 String?
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  applications            Application[]
  jobs                    Job[]
  notificationPreferences NotificationPreferences?
  payments                Payment[]
  savedJobs               SavedJob[]

  @@index([email])
  @@index([role])
}

model Job {
  id                         String        @id @default(cuid())
  slug                       String        @unique
  title                      String
  company                    String
  companyLogo                String?
  location                   String
  city                       String?
  state                      String?
  country                    String        @default("US")
  type                       String
  category                   String
  shift                      String?
  clearance                  String?
  certifications             String?
  description                String
  requirements               String
  salary                     String?
  salaryMin                  Int?
  salaryMax                  Int?
  hourlyRate                 String?
  hourlyRateMin              Float?
  hourlyRateMax              Float?
  applyUrl                   String?
  applyEmail                 String?
  enableInternalApplications Boolean       @default(false)
  tags                       String[]
  status                     JobStatus     @default(ACTIVE)
  isFeatured                 Boolean       @default(false)
  featuredUntil              DateTime?
  expiresAt                  DateTime
  viewCount                  Int           @default(0)
  applicationCount           Int           @default(0)
  applyClickCount            Int           @default(0)
  createdAt                  DateTime      @default(now())
  updatedAt                  DateTime      @updatedAt
  email                      String?
  managementToken            String?       @unique
  userId                     String?
  // External job tracking
  source                     JobSource     @default(INTERNAL)
  externalId                 String?       @unique
  sourceUrl                  String?
  lastSynced                 DateTime?
  applications               Application[]
  user                       User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
  payment                    Payment?
  savedBy                    SavedJob[]

  @@index([slug])
  @@index([status])
  @@index([category])
  @@index([type])
  @@index([shift])
  @@index([clearance])
  @@index([certifications])
  @@index([isFeatured])
  @@index([createdAt])
  @@index([userId])
  @@index([email])
  @@index([managementToken])
  @@index([source])
  @@index([externalId])
  @@index([country, state])
  @@index([country])
  @@index([state])
}

model Application {
  id          String   @id @default(cuid())
  jobId       String
  userId      String
  coverLetter String?
  resume      String?
  status      String   @default("pending")
  createdAt   DateTime @default(now())
  job         Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([jobId, userId])
  @@index([userId])
  @@index([jobId])
}

model SavedJob {
  id        String   @id @default(cuid())
  jobId     String
  userId    String
  createdAt DateTime @default(now())
  job       Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([jobId, userId])
  @@index([userId])
}

model Payment {
  id              String   @id @default(cuid())
  userId          String?
  jobId           String   @unique
  stripeSessionId String   @unique
  stripePaymentId String?  @unique
  amount          Int
  isFeatured      Boolean  @default(false)
  status          String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  firstTouch      Json?
  lastTouch       Json?
  job             Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  user            User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([stripeSessionId])
}

model EmployerLead {
  id           String              @id @default(cuid())
  name         String
  workEmail    String
  company      String
  inquiryType  EmployerInquiryType
  hiringVolume HiringVolume
  roles        String
  locations    String?
  timeline     HiringTimeline
  notes        String?
  status       EmployerLeadStatus  @default(NEW)
  firstTouch   Json?
  lastTouch    Json?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  @@index([createdAt])
  @@index([status])
  @@index([workEmail])
}

model Newsletter {
  id         String   @id @default(cuid())
  email      String   @unique
  categories String[]
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([email])
  @@index([isActive])
}

model NotificationPreferences {
  id                   String   @id @default(cuid())
  userId               String   @unique
  newApplications      Boolean  @default(true)
  expirationReminders  Boolean  @default(true)
  weeklyAnalytics      Boolean  @default(true)
  paymentConfirmations Boolean  @default(true)
  jobAlerts            Boolean  @default(true)
  applicationUpdates   Boolean  @default(true)
  savedJobReminders    Boolean  @default(true)
  weeklyDigest         Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

enum UserRole {
  EMPLOYER
  JOB_SEEKER
  ADMIN
}

enum JobStatus {
  PENDING
  ACTIVE
  EXPIRED
  DELETED
}

enum JobSource {
  INTERNAL
  EXTERNAL_JSEARCH
}

enum EmployerInquiryType {
  SINGLE_ROLE
  VOLUME_HIRING
  RECRUITER_AGENCY
  PARTNERSHIP
}

enum HiringVolume {
  ONE
  TWO_TO_FIVE
  SIX_TO_TWENTY
  TWENTY_PLUS
}

enum HiringTimeline {
  NOW
  THIRTY_DAYS
  NINETY_DAYS
  EXPLORING
}

enum EmployerLeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  CLOSED
}
