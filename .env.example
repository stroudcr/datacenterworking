# =============================================================================
# DATABASE (REQUIRED)
# =============================================================================

# Neon PostgreSQL Connection (Recommended - FREE tier available)
# Get from: https://console.neon.tech → Your Project → Connection Details
#
# Development: Use direct connection
# DATABASE_URL=postgresql://username:password@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require
#
# Production: Use POOLED connection (ends with -pooler.neon.tech) for better performance
# DATABASE_URL=postgresql://username:password@ep-xxx-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require
#
# Alternative: Local PostgreSQL (for offline development)
DATABASE_URL="postgresql://user:password@localhost:5432/datacenter_jobs?schema=public"

# =============================================================================
# AUTHENTICATION (REQUIRED)
# =============================================================================

# Generate a random secret: openssl rand -base64 32
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"

# =============================================================================
# STRIPE PAYMENT (REQUIRED FOR JOB POSTING)
# =============================================================================

# Get from: https://dashboard.stripe.com/apikeys
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_SECRET_KEY="sk_test_..."

# Stripe Webhook Secret (for payment confirmation)
# Get from: https://dashboard.stripe.com/webhooks
STRIPE_WEBHOOK_SECRET="whsec_..."

# =============================================================================
# FILE STORAGE (OPTIONAL - For company logos)
# =============================================================================

# Cloudinary (for image uploads) - Get from: https://cloudinary.com/console
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="your-cloud-name"
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET="your-upload-preset"
NEXT_PUBLIC_CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"

# =============================================================================
# EMAIL (OPTIONAL - For newsletter/notifications)
# =============================================================================

# Email (Resend) - Get from: https://resend.com/api-keys
RESEND_API_KEY="re_..."
EMAIL_FROM="noreply@yourdomain.com"

# =============================================================================
# CRON JOBS (REQUIRED FOR VERCEL DEPLOYMENT)
# =============================================================================

# Cron Job Authentication Secret
# Generate a random secret: openssl rand -base64 32
# Vercel automatically passes this in Authorization header for cron requests
CRON_SECRET="your-cron-secret-change-this-in-production"

# =============================================================================
# ADMIN CONFIGURATION
# =============================================================================

ADMIN_EMAIL="admin@yourdomain.com"

# =============================================================================
# SITE CONFIGURATION (REQUIRED)
# =============================================================================

# Your site URL (no trailing slash)
# For development: http://localhost:3000
# For production: https://workindatacenter.com
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# =============================================================================
# REDIS CACHING (OPTIONAL - Significantly improves performance)
# =============================================================================

# Vercel KV (Recommended for Vercel deployments) - $10/month
# Get from: Vercel Dashboard → Storage → Create KV Database
# Automatically populated when you create KV database in Vercel
# KV_URL=
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
# KV_REST_API_READ_ONLY_TOKEN=

# Alternative: Upstash Redis - FREE tier available
# Get from: https://console.upstash.com
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# =============================================================================
# ANALYTICS & MONITORING (OPTIONAL)
# =============================================================================

# Google Analytics
# NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Sentry (Error tracking) - Recommended for production
# Get from: https://sentry.io
# SENTRY_DSN=
# NEXT_PUBLIC_SENTRY_DSN=

# =============================================================================
# DEVELOPMENT ONLY
# =============================================================================

# Disable Next.js telemetry
NEXT_TELEMETRY_DISABLED=1
